# ==============================================================================
# EXPLOREX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND CLIENT VARIABLES (Vite - Exposed to the browser bundle)
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous API Key (Protected by Postgres Row Level Security)
VITE_SUPABASE_ANON_KEY=

# Base URL for API requests. Leave empty in Vercel production to use relative /api/chat.
# For local development with standalone Express server, set to http://localhost:5005/api
VITE_API_URL=

# Deployment Base Path. Set to '/' for Vercel / Netlify root domains.
# Set to '/Explorex/' when hosting on GitHub Pages (https://<user>.github.io/Explorex/).
VITE_BASE_PATH=

# Google OAuth 2.0 Client ID for Google Sign-In (Optional)
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN for production observability and error telemetry (Optional)
VITE_SENTRY_DSN=


# ------------------------------------------------------------------------------
# 2. SERVERLESS & BACKEND PRIVATE SECRETS (Vercel Serverless / Express Server)
# These variables must exist ONLY in server-side runtime environments.
# ------------------------------------------------------------------------------

# OpenRouter AI API Key for RAG responses & streaming AI guide (Server-only)
OPENROUTER_API_KEY=

# OpenRouter AI Model Identifier (default: google/gemma-3-27b-it:free)
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Supabase Privileged Service Role Key (Bypasses RLS - Server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouteService API Key for geocoding & elevation queries (Optional)
ORS_API_KEY=

# Secret key used for signing session JWT tokens in standalone backend mode
JWT_SECRET=

# Local development port for the standalone Express API server (default: 5005)
PORT=5005

# Allowed CORS origins for the Express backend server (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5180,https://explorex.in

# MongoDB connection URI (Optional - only if using legacy Mongo store)
MONGODB_URI=
